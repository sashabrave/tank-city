; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="War Cats"
config/description="War Cats: защити штаб, угони технику, собери билд."
config/version="0.5.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Рубеж - 13"
config/features=PackedStringArray("4.7", "Forward Plus")
config/build="153"

[audio]

default_bus_layout=""

[autoload]

Texts="*res://scripts/ui/game_texts.gd"
Game="*res://scripts/game.gd"
Settings="*res://scripts/settings.gd"
InterfaceTheme="*res://scripts/ui/interface_theme.gd"
CardNavigation="*res://scripts/card_navigation.gd"
NumberDisplay="*res://scripts/ui/number_display.gd"
ResourceStrip="*res://scripts/ui/resource_strip.gd"
ProfileMenu="*res://scripts/ui/profile_menu.gd"
PerfOverlay="*res://scripts/ui/perf_overlay.gd"
InputScheme="*res://scripts/input_scheme.gd"
TouchHints="*res://scripts/ui/touch_hints.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://assets/ui/field_theme.tres"

[rendering]

renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.73, 0.75, 0.71, 1)

[shader_globals]

cozy_enabled={
"type": "bool",
"value": true
}
cozy_rim={
"type": "float",
"value": 0.45
}
cozy_shiny={
"type": "bool",
"value": true
}
